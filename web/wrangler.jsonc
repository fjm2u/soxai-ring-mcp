{
  "name": "soxai-ring-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soxai-ring-mcp",
      "database_id": "SET_YOUR_DATABASE_ID",
    },
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "SET_YOUR_NAMESPACE_ID" }],
  "vars": {
    "PUBLIC_URL": "https://soxai-ring-mcp.YOUR_SUBDOMAIN.workers.dev",
  },
}
